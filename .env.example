# ==========================================
# KKR CHATBOT - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Generate a strong admin key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ========================================
# AWS CREDENTIALS
# ========================================
# For production: prefer IAM roles (EC2/Lambda) over hardcoded keys.
# IMPORTANT: Never commit actual credentials to git!
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_REGION=us-east-1

# ========================================
# LLM PROVIDER CONFIGURATION
# ========================================
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_EMBEDDINGS_MODEL_ID=amazon.titan-embed-text-v1

# ========================================
# AWS ENDPOINTS
# ========================================
# For production on real AWS, leave these commented out to use default AWS endpoints.
# For local development, uncomment and set to docker-compose endpoints:
# AWS_ENDPOINT_URL=http://localhost:9000
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# ========================================
# DATABASE & STORAGE
# ========================================
DYNAMODB_TABLE_CANDIDATES=page_candidates
DYNAMODB_TABLE_CACHE=response_cache
DYNAMODB_TABLE_SESSIONS=session_history
S3_BUCKET_INDEX=kkr-chatbot-index-prod

# ========================================
# ADMIN API SECURITY
# ========================================
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-before-deploying

# ========================================
# SERVER CONFIGURATION
# ========================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ========================================
# LANGSMITH OBSERVABILITY (Optional)
# ========================================
# Sign up at https://smith.langchain.com/ to get your API key.
# Leave blank to disable LangSmith tracing.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kkr-chatbot

# ========================================
# LOCAL DEVELOPMENT ONLY (docker-compose)
# ========================================
# Uncomment ONLY for local development with docker-compose.
# Comment these out for production on AWS.
#
# MINIO_ENDPOINT_URL=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
